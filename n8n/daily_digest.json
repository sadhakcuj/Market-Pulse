{
  "name": "Daily watchlist digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 8 * * 1-5"
            }
          ]
        }
      },
      "id": "s1",
      "name": "Weekdays 08:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return ($env.WATCHLIST || 'AAPL,MSFT,NVDA').split(',').map(t => ({ json: { ticker: t.trim().toUpperCase() } }));"
      },
      "id": "s2",
      "name": "Watchlist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.STOCK_API_URL }}/v1/analyze/{{ $json.ticker }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.STOCK_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 3000
          }
        }
      },
      "id": "s3",
      "name": "Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(d => d.ticker);\nconst flag = d => (d.sentiment.available && Math.abs(d.sentiment.score) >= 0.35) || (d.technicals.rsi_14 !== null && (d.technicals.rsi_14 >= 70 || d.technicals.rsi_14 <= 30));\nconst line = d => `${flag(d) ? '*' : '-'} ${d.ticker} $${d.technicals.price} (${d.technicals.change_1d_pct}% 1d) | RSI ${d.technicals.rsi_14} | news ${d.sentiment.available ? d.sentiment.label + ' ' + d.sentiment.score : 'n/a'}`;\nconst text = ['Watchlist digest (* = unusual sentiment or RSI)', ...rows.map(line), '', 'Informational only. Not investment advice.'].join('\\n');\nreturn [{ json: { text, flagged: rows.filter(flag).length } }];"
      },
      "id": "s4",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_CHANNEL }}",
        "text": "={{ $json.text }}"
      },
      "id": "s5",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        960,
        -80
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.DIGEST_EMAIL }}",
        "subject": "=Watchlist digest: {{ $json.flagged }} flagged",
        "message": "={{ $json.text }}",
        "options": {}
      },
      "id": "s6",
      "name": "Email digest",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        960,
        80
      ]
    }
  ],
  "connections": {
    "Weekdays 08:30": {
      "main": [
        [
          {
            "node": "Watchlist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Watchlist": {
      "main": [
        [
          {
            "node": "Analyze",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze": {
      "main": [
        [
          {
            "node": "Build digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build digest": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  }
}